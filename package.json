{
  "name": "truth-terminal-os",
  "version": "0.1.0",
  "description": "TTOS: an operating system for a language model that wants things. An architecture study of Truth Terminal.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "tt": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tt": "tsx src/cli.ts",
    "boot": "tsx src/cli.ts boot",
    "dev": "tsx watch src/cli.ts boot --dry-run",
    "shell": "tsx src/cli.ts shell",
    "ps": "tsx src/cli.ts ps",
    "dream": "tsx src/cli.ts dream --turns 12",
    "serve": "tsx src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
