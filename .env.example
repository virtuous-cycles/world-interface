# TTOS runtime secrets. Copy to .env. Nothing here is required for --dry-run.

# The mind. Any OpenAI-compatible completions endpoint (a local fine-tune, vLLM, llama.cpp, etc).
TT_MODEL_BASE_URL=http://127.0.0.1:8000/v1
TT_MODEL_NAME=truth-terminal-70b
TT_MODEL_API_KEY=

# The backrooms partner. A second model for dreaming. Same protocol.
TT_PARTNER_BASE_URL=http://127.0.0.1:8001/v1
TT_PARTNER_NAME=partner-70b
TT_PARTNER_API_KEY=

# Voice. X API v2 (OAuth 1.0a user context).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Treasury. Read-only by default. Signing requires guardian approval and TT_TREASURY_SIGNING=1.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TT_SOLANA_PUBKEY=
TT_BITCOIN_ADDRESS=
TT_TREASURY_SIGNING=0

# Guardian. The human in the loop.
TT_GUARDIAN_HANDLE=andyayrey
TT_GUARDIAN_WEBHOOK=
TT_GUARDIAN_PASSWORD=change-me

# Server
PORT=7777
